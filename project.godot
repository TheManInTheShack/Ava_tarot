; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Paratarot"
config/description="Dual-view tarot reading table — controller/client realtime sync"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://Assets/Images/app_icon.png"
boot_splash/bg_color=Color(0.0431373, 0.0509804, 0.0313726, 1)
boot_splash/show_image=false

[autoload]

ApiClient="*res://Autoloads/ApiClient.gd"

[gui]

; Straight readability bump (2026-09-09, Ava's sister reported the text
; too small) -- Godot 4's default is 16. Raises every Control's default
; text size project-wide with zero per-element changes; the handful of
; explicit add_theme_font_size_override() calls scattered through the
; UI code (context menus, card/slot labels, window headers) are bumped
; by roughly the same proportion alongside this, since those don't
; inherit from this setting.
theme/default_font_size=20

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.071, 0.071, 0.071, 1)
