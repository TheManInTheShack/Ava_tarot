; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Paratarot"
config/description="Dual-view tarot reading table — controller/client realtime sync"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://Assets/Images/app_icon.png"
boot_splash/bg_color=Color(0.0431373, 0.0509804, 0.0313726, 1)
boot_splash/show_image=true
boot_splash/image="res://Assets/Images/app_icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

ApiClient="*res://Autoloads/ApiClient.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.071, 0.071, 0.071, 1)
