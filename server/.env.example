# Copy to .env and fill in real values. Never commit .env.

# Generate hashes with:  python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$...hash_for_sister...
DEV_PASSWORD_HASH=$2b$12$...hash_for_dev...

# Flask session secret — any long random string
FLASK_SECRET=change-me-to-something-random

# Whereby persistent room URL (free tier, no guest login required)
# Create at whereby.com, paste the room URL here
WHEREBY_ROOM_URL=https://whereby.com/your-room-name
